{
  "openapi": "3.0.3",
  "info": {
    "title": "PokeAPI",
    "version": "2.0",
    "description": "Public Pokemon API used as test backend for the O3 pilot agent."
  },
  "servers": [{ "url": "https://pokeapi.co" }],
  "paths": {
    "/api/v2/pokemon/{name}": {
      "get": {
        "operationId": "getPokemon",
        "summary": "Get a Pokemon by name or id",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Pokemon name in lowercase (e.g. pikachu) or its numeric id",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Pokemon data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "integer" },
                    "name": { "type": "string" },
                    "height": { "type": "integer" },
                    "weight": { "type": "integer" },
                    "types": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slot": { "type": "integer" },
                          "type": {
                            "type": "object",
                            "properties": { "name": { "type": "string" } }
                          }
                        }
                      }
                    },
                    "abilities": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "is_hidden": { "type": "boolean" },
                          "ability": {
                            "type": "object",
                            "properties": { "name": { "type": "string" } }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Pokemon not found" }
        }
      }
    }
  }
}
